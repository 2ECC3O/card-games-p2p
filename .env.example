# Optional relay (TURN) for players whose networks block direct connections. See src/network/iceServers.ts.
# Leave everything empty for direct connections only.

# Option 1: Open Relay (Metered) free account. The app fetches fresh credentials when a room is created or joined.
VITE_OPENRELAY_APP=
VITE_OPENRELAY_API_KEY=

# Option 2: a fixed relay login from any TURN provider (comma-separated URLs). Takes priority over option 1.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
